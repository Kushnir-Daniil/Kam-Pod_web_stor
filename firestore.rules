rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleOf(data) {
      return data.keys().hasAny(['role'])
        ? data.role
        : (data.get('isAdmin', false) == true ? 'admin' : 'user');
    }

    function myRole() {
      return roleOf(userDoc());
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isKazkar() {
      return signedIn() && (myRole() == 'kazkar' || myRole() == 'admin');
    }

    function isActive() {
      return signedIn() && userDoc().get('status', 'active') != 'blocked';
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email == 'kn1b24.kushnir@kpnu.edu.ua';
    }

    // ----- users -----
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.status == 'active'
        && (
          (request.resource.data.role == 'user' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'kazkar' && request.resource.data.get('isAdmin', false) == false)
          || (request.resource.data.role == 'admin' && isAdminEmail())
        );

      // Власник: без ескалації ролі / саморозблокування
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == roleOf(resource.data)
        && request.resource.data.status == resource.data.get('status', 'active')
        && request.resource.data.get('isAdmin', false) == (roleOf(resource.data) == 'admin');

      allow update, delete: if isAdmin();
    }

    // ----- invite codes (казкар) -----
    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow update: if signedIn()
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.maxUses == resource.data.maxUses
        && request.resource.data.usedCount == resource.data.usedCount + 1;

      allow create, delete: if isAdmin();
    }

    // ----- quests (коли перенесете з IndexedDB у Firestore) -----
    match /quests/{questId} {
      allow read: if signedIn() && (
        resource.data.status == 'published'
        || isAdmin()
        || (isKazkar() && resource.data.authorId == request.auth.uid)
      );

      allow create: if isKazkar()
        && isActive()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending_review'];

      allow update: if isAdmin()
        || (
          isKazkar()
          && isActive()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.status in ['draft', 'pending_review', 'archived']
        );

      allow delete: if isAdmin()
        || (isKazkar() && resource.data.authorId == request.auth.uid && resource.data.status == 'draft');
    }
  }
}
